{
  "type": "page",
  "title": "P2 home",
  "body": [
    {
      "type": "button",
      "label": "Open detail",
      "actionType": "url",
      "url": "detail"
    },
    {
      "type": "form",
      "name": "alphaForm",
      "title": "Alpha operation",
      "api": "post:alpha",
      "body": [
        {
          "type": "input-text",
          "name": "marker",
          "label": "Alpha marker",
          "value": "P2-INPUT-ALPHA",
          "required": true
        },
        {
          "type": "input-number",
          "name": "quantity",
          "label": "Quantity",
          "value": 3
        },
        {
          "type": "switch",
          "name": "enabled",
          "label": "Enabled",
          "value": true
        },
        {
          "type": "input-array",
          "name": "tags",
          "label": "Tags",
          "value": [
            "one",
            "two"
          ],
          "items": {
            "type": "input-text"
          }
        },
        {
          "type": "select",
          "name": "action",
          "label": "Action",
          "value": "save",
          "options": [
            {
              "label": "save",
              "value": "save"
            },
            {
              "label": "slow",
              "value": "slow"
            },
            {
              "label": "pause",
              "value": "pause"
            }
          ]
        },
        {
          "type": "tpl",
          "tpl": "Alpha result: ${marker} / ${quantity} / ${enabled}"
        }
      ],
      "actions": [
        {
          "type": "submit",
          "label": "Submit alpha"
        }
      ]
    },
    {
      "type": "form",
      "name": "betaForm",
      "title": "Beta operation",
      "api": "post:beta",
      "body": [
        {
          "type": "input-text",
          "name": "marker",
          "label": "Beta marker",
          "value": "P2-INPUT-BETA",
          "required": true
        },
        {
          "type": "input-number",
          "name": "quantity",
          "label": "Quantity",
          "value": 3
        },
        {
          "type": "switch",
          "name": "enabled",
          "label": "Enabled",
          "value": true
        },
        {
          "type": "input-array",
          "name": "tags",
          "label": "Tags",
          "value": [
            "one",
            "two"
          ],
          "items": {
            "type": "input-text"
          }
        },
        {
          "type": "select",
          "name": "action",
          "label": "Action",
          "value": "save",
          "options": [
            {
              "label": "save",
              "value": "save"
            },
            {
              "label": "slow",
              "value": "slow"
            },
            {
              "label": "pause",
              "value": "pause"
            }
          ]
        },
        {
          "type": "tpl",
          "tpl": "Beta result: ${marker} / ${quantity} / ${enabled}"
        }
      ],
      "actions": [
        {
          "type": "submit",
          "label": "Submit beta"
        }
      ]
    }
  ]
}
