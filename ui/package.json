{
  "name": "@kestra-plugin-amis-apps/runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:sdk": "node scripts/extract-sdk.mjs",
    "build": "npm run prepare:sdk && vite build && node scripts/runtime-manifest.mjs && node scripts/evidence.mjs && node scripts/classpath-manifest.mjs",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/unit.xml tests/*.test.mjs",
    "test:chromium": "playwright test",
    "test:translations": "node scripts/translations.mjs",
    "test:preferences:red": "playwright test --config playwright.preferences.config.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4177",
    "test:p1": "playwright test --config playwright.p1.config.mjs",
    "test:p2": "playwright test --config playwright.p2.config.mjs"
  },
  "dependencies": {
    "amis": "6.13.0",
    "amis-core": "6.13.0",
    "amis-formula": "6.13.0",
    "amis-ui": "6.13.0",
    "echarts": "5.5.1",
    "office-viewer": "0.3.17",
    "react": "16.14.0",
    "react-cropper": "2.1.8",
    "react-dom": "16.14.0",
    "react-is": "16.13.1"
  },
  "overrides": {
    "react-cropper": "2.1.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "vite": "8.3.8"
  }
}
